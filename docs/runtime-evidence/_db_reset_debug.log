2026/07/13 19:48:55 PG Send: {"Type":"Parse","Name":"","Query":"create or replace function public.leave_request_units(p_leave_request_id uuid)\nreturns numeric\nlanguage sql stable security definer\nset search_path = public, pg_temp\nas $$\n  select case\n    when lr.duration_unit = 'hour' then coalesce(lr.hours_count,0)\n    else coalesce(lr.days_count,0)\n  end\n  from public.leave_requests lr where lr.id = p_leave_request_id\n$$","ParameterOIDs":null}
