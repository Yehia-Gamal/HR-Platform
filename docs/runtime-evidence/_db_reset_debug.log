2026/07/13 19:48:42 PG Send: {"Type":"Parse","Name":"","Query":"-- لا سياسة كتابة على role_permissions: عبر rpc_set_role_permissions فقط.\n\n-- إسناد الأدوار: يقرأ المستخدم إسناده، والمخوّل يقرأ الكل. لا كتابة مباشرة — عبر rpc_assign_role فقط.\ncreate policy user_roles_read on public.user_roles for select to authenticated\n  using (user_id = auth.uid() or public.has_permission('access.role.assign'))","ParameterOIDs":null}
