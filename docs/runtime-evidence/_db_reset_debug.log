2026/07/13 19:48:42 PG Send: {"Type":"Parse","Name":"","Query":"-- هل المستخدم full-access؟ (admin/super-admin فقط — HR/التنفيذي ليسا full-access)\ncreate or replace function public.current_is_full_access()\nreturns boolean\nlanguage sql stable security definer set search_path = public, pg_temp\nas $$\n  select exists (\n    select 1 from public.roles r\n    where r.id = any (public.current_role_ids())\n      and r.is_full_access = true\n  );\n$$","ParameterOIDs":null}
