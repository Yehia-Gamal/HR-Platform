2026/07/13 19:48:54 PG Send: {"Type":"Parse","Name":"","Query":"create or replace function public.passkey_credentials_force_untrusted()\nreturns trigger\nlanguage plpgsql\nsecurity invoker\nset search_path = public, pg_temp\nas $$\ndeclare\n  v_claim_role text := coalesce(\n    current_setting('request.jwt.claim.role', true),\n    auth.jwt()-\u003e\u003e'role',\n    ''\n  );\n  v_is_trusted_server boolean := false;\nbegin\n  v_is_trusted_server :=\n    v_claim_role = 'service_role'\n    or session_user in ('postgres','supabase_admin','service_role');\n\n  if not v_is_trusted_server then\n    new.trusted := false;\n    new.sign_count := case when tg_op = 'INSERT' then 0 else old.sign_count end;\n    new.last_used := case when tg_op = 'INSERT' then null else old.last_used end;\n  end if;\n\n  return new;\nend;\n$$","ParameterOIDs":null}
