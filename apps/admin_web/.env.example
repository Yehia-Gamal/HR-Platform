# متغيرات بيئة واجهة admin_web (Vite) — انسخ هذا الملف إلى .env.local محليًا،
# أو أدخِل القيم في Vercel → Project → Settings → Environment Variables.
# لا تضع أي سر خادمي هنا (Service Role / CRON_SECRET) — تلك تبقى في Supabase Secrets فقط.

# رابط مشروع Supabase (Project URL) — مثال: https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# المفتاح العام القابل للنشر (publishable / anon key) — آمن للواجهة، ليس service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# يجب أن يبقى false في Staging/Production (يفعّل بيانات التطوير الوهمية فقط في وضع DEV).
VITE_ENABLE_DEV_MOCKS=false

# بيانات وسم الإصدار (تظهر في الواجهة وحوكمة الإصدار).
VITE_APP_VERSION=0.10.0
VITE_APP_BUILD=10

# البيئة: development | staging | production
VITE_APP_ENVIRONMENT=staging

# Sentry DSN (public) — يُفعّل رصد الأخطاء في الواجهة. اتركه فارغًا للتعطيل.
VITE_SENTRY_DSN=
