{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web"
      ],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "admin-web-mocks",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_ENABLE_DEV_MOCKS=true&& npm run dev --workspace @ahla/admin-web -- --port 4180 --strictPort"
      ],
      "port": 4180
    },
    {
      "name": "vercel-live",
      "url": "https://ahla-shabab-management-os.vercel.app",
      "port": 443
    },
    {
      "name": "mobile-web-live",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-X",
        "utf8",
        "-u",
        "D:/tmp/w/flutter_live.py"
      ],
      "port": 5050
    }
  ]
}
