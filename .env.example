# Web public configuration. Never put service-role keys here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_ENABLE_DEV_MOCKS=false
VITE_APP_VERSION=0.10.0
VITE_APP_BUILD=10
VITE_APP_ENVIRONMENT=development
# Error monitoring (Sentry) — leave empty to disable
VITE_SENTRY_DSN=

# Edge Functions only (configure with Supabase secrets, never commit values)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# ALLOWED_ORIGINS=https://admin.example.org,https://app.example.org
# WEBAUTHN_RP_ID=app.example.org
# WEBAUTHN_RP_NAME=Ahla Shabab Management OS
# APP_INVITE_REDIRECT_URL=https://app.example.org/auth/callback
# LOGIN_HASH_PEPPER=generate-a-random-secret-at-least-32-characters

# Scheduled jobs and delivery adapters (Edge secrets only)
# CRON_SECRET=generate-a-random-secret-at-least-32-chars
# PUSH_PROVIDER_URL=https://your-trusted-push-adapter.example/send
# PUSH_PROVIDER_TOKEN=
# WEBAUTHN_ALLOWED_ORIGINS=https://app.example.org

# Integration outbox worker
# INTEGRATION_WEBHOOK_TOKEN=
# INTEGRATION_TOKEN_<INTEGRATION_SLUG>=
